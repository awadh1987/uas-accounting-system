generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Note: For production Supabase / Cloud PostgreSQL deployment, run `npm run db:postgres`
// (or set provider = "sqlite") and apply Row-Level Security (RLS) policies.

// ---------------------------------------------------------
// 1. CHART OF ACCOUNTS & DOUBLE-ENTRY GENERAL LEDGER
// ---------------------------------------------------------

model Account {
  id         String    @id @default(cuid())
  code       String    @unique // e.g. "111101"
  nameAr     String
  nameEn     String
  level      Int // 1 (Class / Gen 1) to 6 (Operational Posting Leaf / Gen 6)
  type       String // ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  isPosting  Boolean   @default(false) // False for Gen 1-4 & branched Gen 5, True for leaf Gen 5 & Gen 6
  parentCode String? // Optional recursive parentCode for fast hierarchical lineage
  parentId   String?
  parent     Account?  @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   Account[] @relation("AccountHierarchy")

  journalLines JournalEntryLine[]
  vendors      Vendor[]
  customers    Customer[]
  workers      Worker[]
  treasury     TreasuryAccount?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // === Phase 1: 6-Generation COA / sub-ledger binding ===
  generation          Int         @default(1) // mirrors level (1..6)
  parentAccountId     String? // mirrors parentId
  isPostable          Boolean     @default(false) // mirrors isPosting (self-healed on first post)
  subLedgerType       String? // CUSTOMER | VENDOR | WORKER | TREASURY | WAREHOUSE | PROJECT | NONE
  subLedgerEntityId   String?
  defaultCostCenterId String?
  defaultCostCenter   CostCenter? @relation("AccountDefaultCostCenter", fields: [defaultCostCenterId], references: [id], onDelete: SetNull)
  glCustomers         Customer[]  @relation("CustomerGlAccount")
  glVendors           Vendor[]    @relation("VendorGlAccount")
  glWorkers           Worker[]    @relation("WorkerGlAccount")
  glWarehouses        Warehouse[] @relation("WarehouseGlAccount")
  glProjects          Project[]   @relation("ProjectGlAccount")

  isActive            Boolean     @default(true)
  archivedAt          DateTime?
}

model JournalEntry {
  id           String      @id @default(cuid())
  entryNumber  String      @unique // e.g. "JV-2026-0001"
  date         DateTime
  reference    String? // External ref, PO#, Bill#, Invoice#, Voucher#
  narrationAr  String
  narrationEn  String?
  status       String      @default("POSTED") // DRAFT | PENDING_APPROVAL | APPROVED | POSTED | VOIDED
  sourceType   String? // OPENING | VENDOR_BILL | VENDOR_PAYMENT | SALES_INVOICE | CUSTOMER_RECEIPT | EXPENSE | WORKER_ACCRUAL | WORKER_PAYOUT | ADJUSTMENT | MANUAL | YEAR_END_CLOSING
  sourceId     String?
  entryType    String      @default("NORMAL") // NORMAL | OPENING | ADJUSTMENT | YEAR_END_CLOSING
  fiscalYearId String?
  fiscalYear   FiscalYear? @relation(fields: [fiscalYearId], references: [id], onDelete: SetNull)
  projectId    String?
  project      Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  subProjectId String?
  subProject   SubProject? @relation(fields: [subProjectId], references: [id], onDelete: SetNull)

  lines       JournalEntryLine[]
  attachments Attachment[]
  createdById String
  createdBy   User               @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  documentStatus    String   @default("POSTED") // DRAFT | PENDING_APPROVAL | APPROVED | POSTED | AMENDMENT_PENDING | REJECTED | VOIDED
  revisionNumber    Int      @default(1)
  isReversed        Boolean  @default(false)
  reversedByEntryId String?
}

model JournalEntryLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  debit        Decimal @default(0)
  credit       Decimal @default(0)
  currency     String  @default("YER")
  currencyCode String  @default("YER")
  exchangeRate Decimal @default(1.0)

  // Multi-Currency Normalized amounts (Foreign + Base YER)
  foreignDebit  Decimal @default(0)
  foreignCredit Decimal @default(0)
  debitBase     Decimal @default(0)
  creditBase    Decimal @default(0)
  baseDebit     Decimal @default(0)
  baseCredit    Decimal @default(0)

  memo           String?
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  subProjectId   String?
  subProject     SubProject?   @relation(fields: [subProjectId], references: [id], onDelete: SetNull)
  harvestCycleId String?
  harvestCycle   HarvestCycle? @relation(fields: [harvestCycleId], references: [id], onDelete: SetNull)

  costCenterId String?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
}

model Attachment {
  id             String        @id @default(cuid())
  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  fileName       String
  fileUrl        String
  fileType       String
  createdAt      DateTime      @default(now())
}

// ---------------------------------------------------------
// 2. ENTERPRISE PROFILE, SETTINGS & PROJECTS
// ---------------------------------------------------------

model EnterpriseProfile {
  id            String  @id @default("default")
  legalNameAr   String
  legalNameEn   String
  taxNumber     String?
  commercialReg String?
  currencyCode  String  @default("YER")
  isConfigured  Boolean @default(false)
  address       String?
  phone         String?
  email         String?
  logoUrl       String?
  faviconUrl    String?
  brandColor    String  @default("#059669")
  taglineAr     String  @default("")
  taglineEn     String  @default("")

  // Dual Logo Generator & Toggle Settings
  showUasLogo             Boolean @default(true)
  uasLogoStyle            String  @default("official-brand")
  uasLogoCustomUrl        String?
  showEnterpriseLogo      Boolean @default(false)
  enterpriseLogoStyle     String  @default("agri-leaf")
  enterpriseLogoCustomUrl String?

  // Landing Page CMS
  heroBadgeAr       String  @default("منصة محاسبة وتخطيط موارد المؤسسات الزراعية | UAS ERP 2026")
  heroBadgeEn       String  @default("Enterprise Agricultural Accounting & ERP | UAS 2026")
  heroTitleAr       String  @default("النظام المحاسبي الموحد لإدارة المشاريع الزراعية والقطفات والمخزون")
  heroTitleEn       String  @default("Unified Accounting System for Agricultural Projects, Harvests & Supply Chain")
  heroSubtitleAr    String  @default("دفتر يومية مزدوج القيد، شجرة حسابات خماسية، متابعة المشتريات والموردين، وإدارة الخزينة والبنوك والمحافظ الإلكترونية بدقة لحظية.")
  heroSubtitleEn    String  @default("Double-entry General Ledger, 5-tier COA, procurement & 3-way matching, and multi-currency vaults, banks & digital wallets.")
  aboutMissionAr    String  @default("تمكين المؤسسات الزراعية والتجارية من إدارة مشاريعها وقطفاتها ومستحقات الموردين والعملاء بشفافية مالية كاملة وتقارير فورية.")
  aboutMissionEn    String  @default("Empowering agricultural enterprises with full financial transparency, harvest-cycle control, and audit-ready reporting.")
  contactPhone      String  @default("")
  contactWhatsApp   String  @default("")
  contactAddress    String  @default("الجمهورية اليمنية - صنعاء")
  showPublicMetrics Boolean @default(true)
  showPublicVerify  Boolean @default(true)
  ctaPrimaryTextAr  String  @default("دخول النظام المحاسبي")
  ctaPrimaryTextEn  String  @default("Enter ERP Workspace")

  // Tenant Branded Workspace & Landing Portal fields
  tenantSlug        String?
  welcomeNoticeAr   String  @default("")
  welcomeNoticeEn   String  @default("")
  supportEmail      String  @default("")

  updatedAt DateTime @updatedAt
}

model SystemSettings {
  id                      String   @id @default("default")
  orgName                 String   @default("شركة الجبري الزراعية للتنمية والاستثمار | UAS")
  logoText                String   @default("UAS")
  defaultLang             String   @default("ar")
  defaultTheme            String   @default("emerald")
  defaultCurrency         String   @default("YER")
  fiscalYearStart         String?  @default("2026-01-01")
  fiscalYearEnd           String?  @default("2026-12-31")
  periodLockDate          String?
  requireApprovalWorkflow Boolean  @default(false)
  enforceThreeWayMatch    Boolean  @default(true)
  threeWayTolerancePct    Decimal  @default(0)
  threeWayToleranceAmount Decimal  @default(0.01)
  costingMethod           String   @default("WEIGHTED_AVERAGE") // WEIGHTED_AVERAGE | FIFO
  negativeStockPolicy     String   @default("BLOCK") // BLOCK | WARN
  printLayout             String   @default("A4") // A4 | 80MM | CUSTOM
  controlAccountsJson     String   @default("{}") // JSON map of default GL control accounts
  documentSequencesJson   String   @default("{}") // JSON map of JV-/RV-/PV-/INV-/BILL-/TRN- prefixes & counters
  autoSyncEnabled         Boolean  @default(true)
  autoSyncIntervalSec     Int      @default(60)
  defaultDeviceSyncMode   String   @default("AUTO") // AUTO | MANUAL
  requireDeviceApproval   Boolean  @default(false)
  tenantAdminConfigJson   String   @default("{}")
  updatedAt               DateTime @updatedAt
}

model CurrencyRate {
  currencyCode String   @id // YER | SAR | USD
  rateToYER    Decimal
  updatedAt    DateTime @updatedAt
}

model Currency {
  id             String         @id @default(cuid())
  code           String         @unique // e.g., YER, SAR, USD, AED, OMR, or custom code
  nameAr         String
  nameEn         String
  symbol         String         @default("")
  decimalPlaces  Int            @default(2) // 0 for YER, 2 for USD/SAR/AED, 3 for OMR
  isBaseCurrency Boolean        @default(false)
  isCustom       Boolean        @default(false)
  isActive       Boolean        @default(true)
  exchangeRates  ExchangeRate[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ExchangeRate {
  id           String   @id @default(cuid())
  currencyCode String
  currency     Currency @relation(fields: [currencyCode], references: [code], onDelete: Cascade)
  rateDate     DateTime @default(now())
  buyRate      Decimal
  sellRate     Decimal
  midRate      Decimal
  source       String   @default("MANUAL")
  createdBy    String?
  createdAt    DateTime @default(now())

  @@index([currencyCode, rateDate])
}

model Project {
  id                  String    @id @default(cuid())
  code                String    @unique
  name                String // Kept for compatibility with operational tabs
  nameAr              String
  nameEn              String
  type                String    @default("مشروع رئيسي") // مشروع رئيسي | مشروع فرعي
  parentProjectId     String?
  parentProject       Project?  @relation("ProjectHierarchy", fields: [parentProjectId], references: [id], onDelete: SetNull)
  childProjects       Project[] @relation("ProjectHierarchy")
  vendorId            String?
  ownerVendor         Vendor?   @relation("ProjectOwnerVendor", fields: [vendorId], references: [id], onDelete: SetNull)
  budgetTotal         Decimal   @default(0)
  estimatedValue      Decimal   @default(0)
  plannedHarvestCount Int       @default(1)
  status              String    @default("ACTIVE")
  startDate           DateTime?
  endDate             DateTime?
  notes               String    @default("")

  subProjects      SubProject[]
  harvestCycles    HarvestCycle[]
  acquisitions     ProjectAcquisitionCycle[]
  journalEntries   JournalEntry[]
  journalLines     JournalEntryLine[]
  purchaseOrders   PurchaseOrder[]
  vendorBills      VendorBill[]
  paymentVouchers  PaymentVoucher[]
  salesInvoices    SalesInvoice[]
  inventoryLots    InventoryLot[]
  expenses         OperatingExpense[]
  workerWages      WorkerWageEntry[]
  sales            SaleTransaction[]
  inventoryBatches HarvestInventoryBatch[]
  adjustments      AdjustmentEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  glAccountId  String?
  glAccount    Account?    @relation("ProjectGlAccount", fields: [glAccountId], references: [id], onDelete: SetNull)
  costCenterId String?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  isActive     Boolean     @default(true)
  archivedAt   DateTime?
}

model ProjectAcquisitionCycle {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cycleTitle     String
  startDate      DateTime
  endDate        DateTime
  contractAmount Decimal  @default(0)
  currency       String   @default("YER")
  status         String   @default("ACTIVE") // DRAFT | ACTIVE | PARTIALLY_PAID | PAID | COMPLETED | VOIDED
  notes          String?

  purchaseOrders  PurchaseOrder[]
  vendorBills     VendorBill[]
  paymentVouchers PaymentVoucher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubProject {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code      String
  nameAr    String
  nameEn    String
  budget    Decimal @default(0)
  status    String  @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED
  notes     String  @default("")
  vendorId  String?
  vendor    Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  journalEntries   JournalEntry[]
  journalLines     JournalEntryLine[]
  purchaseOrders   PurchaseOrder[]
  vendorBills      VendorBill[]
  paymentVouchers  PaymentVoucher[]
  salesInvoices    SalesInvoice[]
  receiptVouchers  ReceiptVoucher[]
  sales            SaleTransaction[]
  expenses         OperatingExpense[]
  workerWages      WorkerWageEntry[]
  inventoryBatches HarvestInventoryBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([projectId, code])
}

model HarvestCycle {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cycleNumber    Int       @default(1)
  name           String
  sortOrder      Int       @default(0)
  isLocked       Boolean   @default(false)
  lockedByUserId String?
  lockedById     String?
  lockedAt       DateTime?
  createdAt      DateTime  @default(now())

  inventoryLots    InventoryLot[]
  journalLines     JournalEntryLine[]
  salesInvoices    SalesInvoice[]
  expenses         OperatingExpense[]
  workerWages      WorkerWageEntry[]
  sales            SaleTransaction[]
  inventoryBatches HarvestInventoryBatch[]
  adjustments      AdjustmentEntry[]

  @@unique([projectId, name])
}

// ---------------------------------------------------------
// 3. PROCUREMENT & VENDORS
// ---------------------------------------------------------

model Vendor {
  id              String  @id @default(cuid())
  code            String  @unique
  nameAr          String
  nameEn          String?
  phone           String
  email           String?
  taxRegistration String?
  address         String?

  accountId String  @unique // Linked Tier 5 Payables Account (2111xx)
  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  ownedProjects  Project[]        @relation("ProjectOwnerVendor")
  subProjects    SubProject[]
  purchaseOrders PurchaseOrder[]
  bills          VendorBill[]
  payments       PaymentVoucher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  glAccountId  String?
  glAccount    Account?    @relation("VendorGlAccount", fields: [glAccountId], references: [id], onDelete: SetNull)
  costCenterId String?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  isActive     Boolean     @default(true)
  archivedAt   DateTime?
}

model PurchaseOrder {
  id                 String                   @id @default(cuid())
  poNumber           String                   @unique // e.g. "PO-2026-0042"
  vendorId           String
  vendor             Vendor                   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  projectId          String
  project            Project                  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  subProjectId       String?
  subProject         SubProject?              @relation(fields: [subProjectId], references: [id], onDelete: SetNull)
  acquisitionCycleId String?
  acquisitionCycle   ProjectAcquisitionCycle? @relation(fields: [acquisitionCycleId], references: [id], onDelete: SetNull)

  date       DateTime @default(now())
  status     String   @default("DRAFT") // DRAFT | PENDING_APPROVAL | APPROVED | POSTED | PAID | VOIDED
  subTotal   Decimal  @default(0)
  taxTotal   Decimal  @default(0)
  grandTotal Decimal  @default(0)
  currency   String   @default("YER")
  notes      String?

  items         PurchaseOrderItem[]
  bills         VendorBill[]
  goodsReceipts GoodsReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  description     String
  unit            String
  quantity        Decimal
  unitPrice       Decimal
  totalPrice      Decimal
}

model GoodsReceipt {
  id              String        @id @default(cuid())
  grnNumber       String        @unique // e.g. "GRN-2026-0012"
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  warehouseId     String?
  journalEntryId  String?
  receivedDate    DateTime      @default(now())
  receivedTotal   Decimal       @default(0)
  hasVariance     Boolean       @default(false)
  itemsSummary    String? // JSON summary of received quantities vs ordered
  itemsJson       String? // Optional line items received into warehouse inventory
  warehouseNotes  String?
  createdAt       DateTime      @default(now())
}

model VendorBill {
  id                 String                   @id @default(cuid())
  billNumber         String                   @unique // e.g. "BILL-2026-0089"
  billType           String                   @default("BILL") // BILL | CREDIT_NOTE | DEBIT_NOTE
  originalBillId     String?
  vendorId           String
  vendor             Vendor                   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  projectId          String
  project            Project                  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  subProjectId       String?
  subProject         SubProject?              @relation(fields: [subProjectId], references: [id], onDelete: SetNull)
  purchaseOrderId    String?
  purchaseOrder      PurchaseOrder?           @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  acquisitionCycleId String?
  acquisitionCycle   ProjectAcquisitionCycle? @relation(fields: [acquisitionCycleId], references: [id], onDelete: SetNull)

  date           DateTime
  dueDate        DateTime?
  status         String    @default("APPROVED") // DRAFT | PENDING_APPROVAL | APPROVED | POSTED | PARTIALLY_PAID | PAID | VOIDED
  subTotal       Decimal   @default(0)
  taxAmount      Decimal   @default(0)
  whtAmount      Decimal   @default(0)
  totalAmount    Decimal
  paidAmount     Decimal   @default(0)
  balanceDue     Decimal
  currency       String    @default("YER")
  currencyCode   String    @default("YER")
  exchangeRate   Decimal   @default(1.0)
  foreignAmount  Decimal   @default(0)
  baseAmount     Decimal   @default(0)
  isInventory    Boolean   @default(false)
  debitAccountId String?
  journalEntryId String?
  notes          String?

  items           VendorBillItem[]
  paymentVouchers PaymentVoucher[]
  createdAt       DateTime         @default(now())

  costCenterId   String?
  costCenter     CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  documentStatus String      @default("POSTED") // DRAFT | PENDING_APPROVAL | APPROVED | POSTED | AMENDMENT_PENDING | REJECTED | VOIDED
  revisionNumber Int         @default(1)
}

model VendorBillItem {
  id          String     @id @default(cuid())
  billId      String
  bill        VendorBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  itemId      String?
  warehouseId String?
  taxCodeId   String?
  description String
  unitId      String?
  quantity    Decimal
  unitPrice   Decimal
  netAmount   Decimal
  taxAmount   Decimal    @default(0)
  whtAmount   Decimal    @default(0)
  totalAmount Decimal

  @@index([billId])
  @@index([itemId])
}

model PaymentVoucher {
  id            String          @id @default(cuid())
  voucherNumber String          @unique // e.g. "PV-2026-0034"
  date          DateTime        @default(now())
  vendorId      String
  vendor        Vendor          @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  billId        String?
  bill          VendorBill?     @relation(fields: [billId], references: [id], onDelete: SetNull)
  allocationsJson String?
  treasuryId    String
  treasury      TreasuryAccount @relation(fields: [treasuryId], references: [id], onDelete: Restrict)

  amount             Decimal
  transferFee        Decimal                  @default(0)
  currency           String                   @default("YER")
  currencyCode       String                   @default("YER")
  exchangeRate       Decimal                  @default(1.0)
  foreignAmount      Decimal                  @default(0)
  baseAmount         Decimal                  @default(0)
  referenceNumber    String?
  notes              String?
  projectId          String?
  project            Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  subProjectId       String?
  subProject         SubProject?              @relation(fields: [subProjectId], references: [id], onDelete: SetNull)
  acquisitionCycleId String?
  acquisitionCycle   ProjectAcquisitionCycle? @relation(fields: [acquisitionCycleId], references: [id], onDelete: SetNull)
  journalEntryId     String?
  qrVerificationHash String?

  createdAt DateTime @default(now())

  costCenterId   String?
  costCenter     CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  documentStatus String      @default("POSTED") // DRAFT | PENDING_APPROVAL | APPROVED | POSTED | AMENDMENT_PENDING | REJECTED | VOIDED
  revisionNumber Int         @default(1)
}

// ---------------------------------------------------------
// 4. CLIENTS, SALES & RECEIVABLES
// ---------------------------------------------------------

model Customer {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String  @unique
  nameAr      String
  nameEn      String?
  phone       String  @default("")
  address     String?
  creditLimit Decimal @default(0)

  accountId String  @unique // Linked Tier 5 Receivables Account (1121xx)
  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  invoices  SalesInvoice[]
  receipts  ReceiptVoucher[]
  sales     SaleTransaction[]
  createdAt DateTime          @default(now())

  glAccountId  String?
  glAccount    Account?    @relation("CustomerGlAccount", fields: [glAccountId], references: [id], onDelete: SetNull)
  costCenterId String?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  isActive     Boolean     @default(true)
  archivedAt   DateTime?
}

model SalesInvoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  invoiceType    String        @default("INVOICE") // INVOICE | CREDIT_NOTE | DEBIT_NOTE
  originalInvoiceId String?
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  subProjectId   String?
  subProject     SubProject?   @relation(fields: [subProjectId], references: [id], onDelete: SetNull)
  harvestCycleId String?
  harvestCycle   HarvestCycle? @relation(fields: [harvestCycleId], references: [id], onDelete: SetNull)

  sequenceNumber     String? // e.g. "SO-2026-0001"
  dailyBatchLabel    String?
  salesOfficerId     String?
  salesOfficerTitle  String?
  revenueAccountCode String?          @default("411101")
  treasuryAccountId  String?
  treasuryAccount    TreasuryAccount? @relation(fields: [treasuryAccountId], references: [id], onDelete: SetNull)

  date               DateTime  @default(now())
  dueDate            DateTime?
  subTotal           Decimal   @default(0)
  taxAmount          Decimal   @default(0)
  whtAmount          Decimal   @default(0)
  totalAmount        Decimal
  paidAmount         Decimal   @default(0)
  balanceDue         Decimal
  status             String    @default("POSTED") // DRAFT | PENDING_APPROVAL | POSTED | PARTIALLY_PAID | PAID | VOIDED
  currency           String    @default("YER")
  currencyCode       String    @default("YER")
  exchangeRate       Decimal   @default(1.0)
  foreignAmount      Decimal   @default(0)
  baseAmount         Decimal   @default(0)
  notes              String?
  journalEntryId     String?
  cogsJournalEntryId String?
  qrVerificationHash String?

  items     SalesInvoiceItem[]
  receipts  ReceiptVoucher[]
  createdAt DateTime         @default(now())

  costCenterId   String?
  costCenter     CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  documentStatus String      @default("POSTED") // DRAFT | PENDING_APPROVAL | APPROVED | POSTED | AMENDMENT_PENDING | REJECTED | VOIDED
  revisionNumber Int         @default(1)
}

model SalesInvoiceItem {
  id              String       @id @default(cuid())
  invoiceId       String
  invoice         SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemId          String?
  warehouseId     String?
  taxCodeId       String?
  description     String
  unitId          String?
  quantity        Decimal
  unitPrice       Decimal
  netAmount       Decimal
  taxAmount       Decimal      @default(0)
  whtAmount       Decimal      @default(0)
  totalAmount     Decimal
  costOfGoodsSold Decimal      @default(0)

  @@index([invoiceId])
  @@index([itemId])
}

model ReceiptVoucher {
  id            String          @id @default(cuid())
  voucherNumber String          @unique
  date          DateTime        @default(now())
  customerId    String
  customer      Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoiceId     String?
  invoice       SalesInvoice?   @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  allocationsJson String?
  treasuryId    String
  treasury      TreasuryAccount @relation(fields: [treasuryId], references: [id], onDelete: Restrict)
  subProjectId  String?
  subProject    SubProject?     @relation(fields: [subProjectId], references: [id], onDelete: SetNull)

  amount             Decimal
  currency           String   @default("YER")
  currencyCode       String   @default("YER")
  exchangeRate       Decimal  @default(1.0)
  foreignAmount      Decimal  @default(0)
  baseAmount         Decimal  @default(0)
  notes              String?
  journalEntryId     String?
  qrVerificationHash String?
  createdAt          DateTime @default(now())

  costCenterId   String?
  costCenter     CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  documentStatus String      @default("POSTED") // DRAFT | PENDING_APPROVAL | APPROVED | POSTED | AMENDMENT_PENDING | REJECTED | VOIDED
  revisionNumber Int         @default(1)
}

// ---------------------------------------------------------
// 5. INVENTORY & AGRICULTURAL LOT TRACKING
// ---------------------------------------------------------

model InventoryLot {
  id              String        @id @default(cuid())
  lotNumber       String        @unique
  projectId       String?
  project         Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  harvestCycleId  String?
  harvestCycle    HarvestCycle? @relation(fields: [harvestCycleId], references: [id], onDelete: SetNull)
  itemId          String?
  warehouseId     String?
  grade           String // "صنف 1", "صنف 2", "روس", "بزغة" or warehouse SKU lot
  initialQuantity Decimal
  currentQuantity Decimal
  shrinkageCount  Decimal       @default(0)
  unitCost        Decimal       @default(0)
  receivedDate    DateTime      @default(now())
  createdAt       DateTime      @default(now())

  @@index([itemId, warehouseId, receivedDate])
}

model HarvestInventoryBatch {
  id               String        @id @default(cuid())
  projectId        String
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subProjectId     String?
  subProject       SubProject?   @relation(fields: [subProjectId], references: [id], onDelete: SetNull)
  harvestCycleId   String?
  harvestCycle     HarvestCycle? @relation(fields: [harvestCycleId], references: [id], onDelete: SetNull)
  harvestName      String
  productGrade     String
  harvestedBundles Int
  shrinkageBundles Int           @default(0)
  notes            String        @default("")
  createdAt        DateTime      @default(now())
}

// ---------------------------------------------------------
// 6. TREASURY, FIELD OPERATIONS & USERS
// ---------------------------------------------------------

model TreasuryAccount {
  id                 String   @id @default(cuid())
  code               String   @unique
  name               String
  nameAr             String
  nameEn             String
  type               String   @default("VAULT") // VAULT | BANK | WALLET
  providerNameAr     String   @default("")
  providerNameEn     String   @default("")
  accountHolderName  String   @default("")
  accountNumber      String
  ibanOrSwift        String   @default("")
  branchOrAgent      String   @default("")
  transferFeePercent Decimal  @default(0)
  dailyLimit         Decimal  @default(0)
  isDefaultReceipts  Boolean  @default(false)
  isDefaultPayments  Boolean  @default(false)
  isActive           Boolean  @default(true)
  notes              String   @default("")
  accountId          String   @unique
  account            Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  balance            Decimal  @default(0)
  balanceYER         Decimal  @default(0)
  currency           String   @default("YER")
  currencyCode       String   @default("YER")
  gatewayProvider    String   @default("MANUAL") // MANUAL | KURAIMI_API | JAWALI_API | JEEB_API | ONECASH_API | FLOOSAK_API | CUSTOM_WEBHOOK
  gatewayMerchantId  String?
  gatewayEndpointUrl String?
  gatewayCredentialsEnc String?
  isSandbox          Boolean  @default(true)
  dailyUsedAmount    Decimal  @default(0)
  lastDailyResetDate String?  // YYYY-MM-DD
  archivedAt         DateTime?
  updatedAt          DateTime @updatedAt

  paymentVouchers   PaymentVoucher[]
  receiptVouchers   ReceiptVoucher[]
  installments      InstallmentVoucher[]
  salesInvoices     SalesInvoice[]
  salesTransactions SaleTransaction[]
  dispatches        BankPaymentDispatch[]
}

model OperatingExpense {
  id             String        @id @default(cuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subProjectId   String?
  subProject     SubProject?   @relation(fields: [subProjectId], references: [id], onDelete: SetNull)
  harvestCycleId String?
  harvestCycle   HarvestCycle? @relation(fields: [harvestCycleId], references: [id], onDelete: SetNull)
  harvestName    String
  category       String // وقود/محروقات | وجبات غذائية | مواد غذائية | أجور نقل | أخرى
  subType        String
  quantity       Decimal       @default(1)
  unitPrice      Decimal       @default(0)
  taxCodeId      String?
  netAmount      Decimal       @default(0)
  taxAmount      Decimal       @default(0)
  whtAmount      Decimal       @default(0)
  totalAmount    Decimal       @default(0)
  expenseDate    String
  notes          String        @default("")
  journalEntryId String?
  documentStatus String        @default("POSTED")
  createdAt      DateTime      @default(now())
}

model Worker {
  id               String            @id @default(cuid())
  name             String            @unique
  phone            String            @default("")
  defaultDailyWage Decimal           @default(0)
  accountId        String?
  account          Account?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  wageEntries      WorkerWageEntry[]

  glAccountId  String?
  glAccount    Account?    @relation("WorkerGlAccount", fields: [glAccountId], references: [id], onDelete: SetNull)
  costCenterId String?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  isActive     Boolean     @default(true)
  archivedAt   DateTime?
}

model WorkerWageEntry {
  id             String               @id @default(cuid())
  workerId       String
  worker         Worker               @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerName     String
  projectId      String
  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subProjectId   String?
  subProject     SubProject?          @relation(fields: [subProjectId], references: [id], onDelete: SetNull)
  harvestCycleId String?
  harvestCycle   HarvestCycle?        @relation(fields: [harvestCycleId], references: [id], onDelete: SetNull)
  harvestName    String
  dailyWage      Decimal
  daysWorked     Decimal
  totalWage      Decimal
  creditAmount   Decimal              @default(0)
  debitBalance   Decimal
  workDate       String
  notes          String               @default("")
  journalEntryId String?
  documentStatus String               @default("POSTED")
  createdAt      DateTime             @default(now())
  installments   InstallmentVoucher[]
}

model SaleTransaction {
  id                 String           @id @default(cuid())
  sequenceNumber     String? // e.g. "SO-2026-0001"
  dailyBatchLabel    String? // e.g. "عملية بيع #5" / "دفعة صباحية"
  salesOfficerId     String?
  salesOfficerTitle  String?
  revenueAccountCode String           @default("411101")
  treasuryAccountId  String?
  treasuryAccount    TreasuryAccount? @relation(fields: [treasuryAccountId], references: [id], onDelete: SetNull)

  projectId        String
  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subProjectId     String?
  subProject       SubProject?          @relation(fields: [subProjectId], references: [id], onDelete: SetNull)
  harvestCycleId   String?
  harvestCycle     HarvestCycle?        @relation(fields: [harvestCycleId], references: [id], onDelete: SetNull)
  harvestName      String
  saleBatchLabel   String
  customerId       String
  customer         Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerName     String
  customerPhone    String
  productGrade     String
  bundlesCount     Int
  unitPrice        Decimal
  totalAmount      Decimal
  creditPaid       Decimal              @default(0)
  debitReceivable  Decimal
  saleDate         String
  receiptVoucherNo String
  notes            String               @default("")
  journalEntryId   String?
  createdAt        DateTime             @default(now())
  installments     InstallmentVoucher[]
}

model InstallmentVoucher {
  id                 String           @id @default(cuid())
  voucherNo          String           @unique
  type               String // CUSTOMER_RECEIPT | WORKER_PAYOUT
  saleTransactionId  String?
  saleTransaction    SaleTransaction? @relation(fields: [saleTransactionId], references: [id], onDelete: SetNull)
  workerWageEntryId  String?
  workerWageEntry    WorkerWageEntry? @relation(fields: [workerWageEntryId], references: [id], onDelete: SetNull)
  targetName         String
  phone              String           @default("")
  treasuryAccountId  String
  treasuryAccount    TreasuryAccount  @relation(fields: [treasuryAccountId], references: [id], onDelete: Restrict)
  amountYER          Decimal
  qrVerificationHash String
  paymentDate        String
  notes              String           @default("")
  journalEntryId     String?
  createdAt          DateTime         @default(now())
}

enum Role {
  SUPER_ADMIN
  PROJECT_MANAGER
  CHIEF_ACCOUNTANT
  PROCUREMENT_OFFICER
  SALES_COLLECTOR
  FIELD_ACCOUNTANT
  EXTERNAL_AUDITOR
}

model User {
  id                    String    @id @default(cuid())
  username              String    @unique
  name                  String
  fullName              String
  displayName           String? // Optional personal display name (defaults to empty so system displays title-only role)
  phone                 String? // Optional personal mobile phone
  email                 String    @unique
  passwordHash          String
  role                  Role      @default(FIELD_ACCOUNTANT)
  department            String    @default("المالية والعمليات")
  active                Boolean   @default(true)
  isActive              Boolean   @default(true)
  archivedAt            DateTime? // Soft-archive timestamp when user has linked accounting/audit records
  avatarChar            String    @default("م")
  avatarUrl             String? // Profile photo URL
  avatarColor           String    @default("#059669")
  preferredLang         String    @default("ar")
  preferredCurrency     String    @default("YER")
  preferredTheme        String    @default("emerald")
  defaultModule         String? // Default home module tab id
  lastLoginAt           DateTime?
  useCustomPermissions  Boolean   @default(false)
  customAllowedGroups   String    @default("[]") // JSON array of allowed ErpGroupId strings
  customPermissionsJson String    @default("{}") // JSON object of granular overrides
  mustChangePassword    Boolean   @default(false)
  passwordUpdatedAt     DateTime?
  assignedProjects      String    @default("[]") // JSON array of project IDs for row-level access
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  journalEntries JournalEntry[]
  auditLogs      AuditLog[]
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  action    String // CREATE, UPDATE, POST, VOID, LOCK
  entity    String // "JournalEntry", "VendorBill", "HarvestCycle"
  entityId  String
  details   Json
  ipAddress String?
  timestamp DateTime @default(now())
}

model ImmutableAuditLog {
  id              String   @id @default(cuid())
  timestamp       String
  userId          String?
  userDisplay     String
  userRole        String
  actionType      String
  entityReference String
  details         String
  sha256Hash      String
  createdAt       DateTime @default(now())
}

model AdjustmentEntry {
  id             String        @id @default(cuid())
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  harvestCycleId String?
  harvestCycle   HarvestCycle? @relation(fields: [harvestCycleId], references: [id], onDelete: SetNull)
  periodLabel    String
  reason         String
  amountYER      Decimal
  createdByUser  String
  journalEntryId String?
  createdAt      DateTime      @default(now())
}

model LicenseState {
  id               String   @id @default("active")
  licenseId        String?  @map("license_id")
  customerName     String?  @map("customer_name")
  hwidHash         String?  @map("hwid_hash")
  lastVerifiedUtc  DateTime @default(now()) @map("last_verified_utc")
  status           String   @default("UNLICENSED") // UNLICENSED | ACTIVE | EXPIRED | HWID_MISMATCH | CLOCK_TAMPER
  seatRegistryJson String   @default("[]") @map("seat_registry_json")
  licenseDataJson  String?  @map("license_data_json")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Company-locked multi-seat licensing: one row per (license, user, platform) device seat.
// Enforces max_users per license and 1 Windows + 1 Android device per user.
model LicenseDeviceBinding {
  id          String   @id @default(cuid())
  licenseId   String
  userEmail   String // stored lower-cased / trimmed by the seat service
  platform    String // "windows" | "android"
  hwid        String
  deviceName  String   @default("")
  activatedAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  active      Boolean  @default(true)

  @@unique([licenseId, userEmail, platform])
  @@index([licenseId])
}

// ---------------------------------------------------------
// 8. MULTI-CURRENCY TREASURY TRANSACTIONS & MULTI-UNIT INVENTORY
// ---------------------------------------------------------

model TreasuryTransaction {
  id            String   @id @default(cuid())
  treasuryId    String
  direction     String // IN | OUT | TRANSFER
  currencyCode  String   @default("YER")
  exchangeRate  Decimal  @default(1.0)
  foreignAmount Decimal  @default(0)
  baseAmount    Decimal  @default(0)
  referenceType String? // RECEIPT | PAYMENT | TRANSFER | FX_REVALUATION
  referenceId   String?
  notes         String?
  date          DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([treasuryId, date])
}

model UnitOfMeasure {
  id            String               @id @default(cuid())
  code          String               @unique // e.g. PIECE, BUNDLE, BAG, CARTON, KG, G, TON, or custom code
  nameAr        String
  nameEn        String
  isBaseDefault Boolean              @default(false)
  isCustom      Boolean              @default(false)
  baseItems     InventoryItem[]      @relation("ItemBaseUnit")
  conversions   ItemUnitConversion[]
  movements     StockMovement[]
  createdAt     DateTime             @default(now())
}

model ItemCategory {
  id        String          @id @default(cuid())
  code      String          @unique
  nameAr    String
  nameEn    String
  parentId  String?
  parent    ItemCategory?   @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  ItemCategory[]  @relation("CategoryHierarchy")
  isCustom  Boolean         @default(false)
  items     InventoryItem[]
  createdAt DateTime        @default(now())
}

model Warehouse {
  id            String          @id @default(cuid())
  code          String          @unique
  nameAr        String
  nameEn        String
  location      String?
  isDefault     Boolean         @default(false)
  isCustom      Boolean         @default(false)
  isActive      Boolean         @default(true)
  archivedAt    DateTime?
  defaultItems  InventoryItem[] @relation("ItemDefaultWarehouse")
  stockBalances StockBalance[]
  movements     StockMovement[]
  createdAt     DateTime        @default(now())

  glAccountId  String?
  glAccount    Account?    @relation("WarehouseGlAccount", fields: [glAccountId], references: [id], onDelete: SetNull)
  costCenterId String?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
}

model InventoryItem {
  id                 String               @id @default(cuid())
  sku                String               @unique
  barcode            String?
  nameAr             String
  nameEn             String
  categoryId         String?
  category           ItemCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  itemType           String               @default("STOCKABLE") // STOCKABLE | SERVICE | CONSUMABLE | or custom type
  grade              String? // Open string supporting custom grades
  origin             String? // Open string supporting custom origins
  baseUnitId         String
  baseUnit           UnitOfMeasure        @relation("ItemBaseUnit", fields: [baseUnitId], references: [id], onDelete: Restrict)
  defaultWarehouseId String?
  defaultWarehouse   Warehouse?           @relation("ItemDefaultWarehouse", fields: [defaultWarehouseId], references: [id], onDelete: SetNull)
  purchasePrice      Decimal              @default(0)
  wholesalePrice     Decimal              @default(0)
  retailPrice        Decimal              @default(0)
  minSellPrice       Decimal              @default(0)
  minStockAlert      Decimal              @default(0)
  maxStockLevel      Decimal              @default(0)
  inventoryAccountId String?
  cogsAccountId      String?
  revenueAccountId   String?
  isActive           Boolean              @default(true)
  archivedAt         DateTime?
  conversions        ItemUnitConversion[]
  balances           StockBalance[]
  movements          StockMovement[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model ItemUnitConversion {
  id                    String        @id @default(cuid())
  itemId                String
  item                  InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unitId                String
  unit                  UnitOfMeasure @relation(fields: [unitId], references: [id], onDelete: Restrict)
  customUnitLabel       String?
  factorToBase          Decimal // Must be > 0, e.g. 1 bundle = 10 pieces, 1 carton = 240 pieces
  barcode               String?
  purchasePrice         Decimal?
  sellPrice             Decimal?
  isDefaultSalesUnit    Boolean       @default(false)
  isDefaultPurchaseUnit Boolean       @default(false)

  @@unique([itemId, unitId])
}

model StockBalance {
  id              String        @id @default(cuid())
  itemId          String
  item            InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouseId     String
  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  qtyOnHandBase   Decimal       @default(0)
  avgUnitCostBase Decimal       @default(0)
  updatedAt       DateTime      @updatedAt

  @@unique([itemId, warehouseId])
}

model StockMovement {
  id            String        @id @default(cuid())
  itemId        String
  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouseId   String
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  movementType  String // PURCHASE_IN | SALE_OUT | ADJUSTMENT_IN | ADJUSTMENT_OUT | TRANSFER_IN | TRANSFER_OUT | OPENING
  enteredQty    Decimal
  enteredUnitId String
  enteredUnit   UnitOfMeasure @relation(fields: [enteredUnitId], references: [id], onDelete: Restrict)
  factorToBase  Decimal       @default(1)
  baseQtyDelta  Decimal // Positive for IN, negative for OUT
  unitCostBase  Decimal       @default(0)
  referenceType String? // INVOICE | BILL | ADJUSTMENT | TRANSFER
  referenceId   String?
  notes         String?
  createdAt     DateTime      @default(now())

  costCenterId   String?
  costCenter     CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  documentStatus String      @default("POSTED") // DRAFT | PENDING_APPROVAL | APPROVED | POSTED | AMENDMENT_PENDING | REJECTED | VOIDED
  revisionNumber Int         @default(1)

  @@index([itemId, warehouseId, createdAt])
}

model CostCenter {
  id          String       @id @default(cuid())
  code        String       @unique
  nameAr      String
  nameEn      String
  parentId    String?
  parent      CostCenter?  @relation("CostCenterHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    CostCenter[] @relation("CostCenterHierarchy")
  generation  Int          @default(1)
  centerType  String       @default("OTHER") // BRANCH | PROJECT | FARM | DEPARTMENT | FLEET | OTHER
  customLabel String?
  isCustom    Boolean      @default(false)
  isActive    Boolean      @default(true)
  archivedAt  DateTime?

  accountsDefault Account[]          @relation("AccountDefaultCostCenter")
  customers       Customer[]
  vendors         Vendor[]
  workers         Worker[]
  warehouses      Warehouse[]
  projects        Project[]
  journalLines    JournalEntryLine[]
  salesInvoices   SalesInvoice[]
  vendorBills     VendorBill[]
  receipts        ReceiptVoucher[]
  payments        PaymentVoucher[]
  stockMovements  StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FiscalYear {
  id                        String         @id @default(cuid())
  code                      String         @unique // e.g., "FY-2026", "FY-2027"
  nameAr                    String
  nameEn                    String
  startDate                 DateTime
  endDate                   DateTime
  status                    String         @default("OPEN") // OPEN | CLOSING_IN_PROGRESS | CLOSED
  closingJournalEntryId     String?
  openingJournalEntryId     String?
  retainedEarningsAccountId String?
  netProfitLossBase         Decimal?
  closedById                String?
  closedByName              String?
  closedAt                  DateTime?
  journalEntries            JournalEntry[]
  periods                   AccountingPeriod[]
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
}

model AccountingPeriod {
  id           String      @id @default(cuid())
  fiscalYearId String?
  fiscalYear   FiscalYear? @relation(fields: [fiscalYearId], references: [id], onDelete: SetNull)
  year         Int
  month        Int
  code         String      @unique // e.g. "2026-05"
  nameAr       String
  nameEn       String
  startDate    DateTime
  endDate      DateTime
  status       String      @default("OPEN") // OPEN | SOFT_CLOSED | HARD_CLOSED
  closedById   String?
  closedAt     DateTime?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([year, month])
  @@index([startDate, endDate, status])
}

model TaxCode {
  id                     String    @id @default(cuid())
  code                   String    @unique // VAT15 | VAT0 | WHT2
  nameAr                 String
  nameEn                 String
  taxType                String    @default("VAT") // VAT | WHT | SALES_TAX
  ratePct                Decimal   @default(0)
  isCompound             Boolean   @default(false)
  isInclusive            Boolean   @default(false)
  salesTaxAccountCode    String?   @default("214101")
  purchaseTaxAccountCode String?   @default("114301")
  whtAccountCode         String?   @default("214201")
  isActive               Boolean   @default(true)
  rates                  TaxRate[]
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model TaxRate {
  id            String    @id @default(cuid())
  taxCodeId     String
  taxCode       TaxCode   @relation(fields: [taxCodeId], references: [id], onDelete: Cascade)
  ratePct       Decimal
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())

  @@index([taxCodeId, effectiveFrom])
}

model WorkspaceDraft {
  id                String   @id @default(cuid())
  draftNumber       String   @unique // e.g., "DRF-2026-0001"
  module            String // ACCOUNTING | SALES | PROCUREMENT | TREASURY | INVENTORY | PROJECTS | WORKERS | SYSTEM
  formType          String // JOURNAL_VOUCHER | SALES_INVOICE | PURCHASE_BILL | RECEIPT_VOUCHER | PAYMENT_VOUCHER | STOCK_MOVEMENT | ITEM_MASTER | VENDOR | CUSTOMER | PROJECT | WORKER_WAGE
  entityId          String? // Optional target record ID when drafting an amendment
  titleAr           String
  titleEn           String   @default("")
  payloadJson       String // Full serialized form + subform line items + cost center + currency
  totalAmount       Decimal?
  currencyCode      String   @default("YER")
  visibility        String   @default("SHARED_WORKSPACE") // SHARED_WORKSPACE | PRIVATE
  status            String   @default("ACTIVE_DRAFT") // ACTIVE_DRAFT | SUBMITTED_FOR_APPROVAL | CONVERTED | DISCARDED
  convertedEntityId String?
  createdById       String
  createdByName     String
  updatedById       String?
  updatedByName     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([module, status])
  @@index([createdById, visibility])
}

model ApprovalRule {
  id                  String            @id @default(cuid())
  module              String // ACCOUNTING | SALES | PROCUREMENT | TREASURY | INVENTORY | PROJECTS | WORKERS | FISCAL_YEAR
  actionType          String // CREATE_AND_POST | GL_POSTING | AMEND_POSTED_RECORD | VOID_RECORD | HIGH_VALUE_TRANSACTION | FISCAL_YEAR_CLOSE
  minAmountBase       Decimal           @default(0)
  currencyCode        String            @default("YER")
  requiredRole        String            @default("CHIEF_ACCOUNTANT")
  approverUserIdsJson String            @default("[]")
  allowSelfApproval   Boolean           @default(false)
  isActive            Boolean           @default(true)
  requests            ApprovalRequest[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([module, actionType, isActive])
}

model ApprovalRequest {
  id                 String        @id @default(cuid())
  requestNumber      String        @unique // e.g., "APR-2026-0001"
  ruleId             String?
  rule               ApprovalRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  module             String
  actionType         String // CREATE_AND_POST | GL_POSTING | AMEND_POSTED_RECORD | VOID_RECORD | HIGH_VALUE_TRANSACTION | FISCAL_YEAR_CLOSE
  targetType         String // JournalEntry | SalesInvoice | VendorBill | ReceiptVoucher | PaymentVoucher | StockMovement | FiscalYear
  targetId           String
  documentNumber     String
  summaryAr          String
  summaryEn          String        @default("")
  amountBase         Decimal       @default(0)
  currencyCode       String        @default("YER")
  beforeSnapshotJson String?
  afterSnapshotJson  String
  reasonAr           String?
  status             String        @default("PENDING") // PENDING | APPROVED | REJECTED | RETURNED_FOR_EDIT
  requestedById      String
  requestedByName    String
  reviewedById       String?
  reviewedByName     String?
  reviewNotes        String?
  reviewedAt         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status, module])
  @@index([targetType, targetId])
}

model IdempotencyRecord {
  id             String    @id @default(cuid())
  idempotencyKey String    @unique
  endpoint       String
  method         String
  userId         String?
  statusCode     Int
  responseJson   String
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  @@index([idempotencyKey])
  @@index([expiresAt])
}

model BankPaymentDispatch {
  id                        String          @id @default(cuid())
  dispatchNumber            String          @unique // DSP-YYYY-XXXX
  treasuryAccountId         String
  treasuryAccount           TreasuryAccount @relation(fields: [treasuryAccountId], references: [id], onDelete: Restrict)
  sourceVoucherType         String          // PAYMENT_VOUCHER | VENDOR_BILL | WORKER_WAGE | TREASURY_TRANSFER
  sourceVoucherId           String
  beneficiaryName           String
  beneficiaryAccountOrPhone String
  amount                    Decimal
  feeAmount                 Decimal         @default(0)
  currencyCode              String          @default("YER")
  exchangeRate              Decimal         @default(1)
  baseAmount                Decimal
  provider                  String          // MANUAL | KURAIMI_API | JAWALI_API | JEEB_API | ONECASH_API | FLOOSAK_API | CUSTOM_WEBHOOK
  externalReferenceId       String?
  status                    String          @default("QUEUED") // QUEUED | PENDING_OTP | EXECUTED | FAILED | RECONCILED
  rawResponseJson           String?
  errorMessage              String?
  idempotencyKey            String          @unique
  costCenterId              String?
  journalEntryId            String?
  executedById              String
  executedByName            String
  executedAt                DateTime?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  @@index([treasuryAccountId])
  @@index([status])
  @@index([provider])
  @@index([sourceVoucherType, sourceVoucherId])
}

// ---------------------------------------------------------
// 9. SYNC ENGINE, NOTIFICATIONS & TENANT DEVICES CONTROL PLANE
// ---------------------------------------------------------

model SyncChangeLog {
  cursor         Int      @id @default(autoincrement())
  entityType     String
  entityId       String
  operation      String   // CREATE | UPDATE | DELETE | POST | VOID
  payloadJson    String
  idempotencyKey String?  @unique
  deviceId       String?
  actorUserId    String?
  createdAt      DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model SyncConflict {
  id                 String    @id @default(cuid())
  entityType         String
  entityId           String
  idempotencyKey     String?
  deviceId           String?
  status             String    @default("CONFLICT_PENDING") // CONFLICT_PENDING | RESOLVED_KEEP_SERVER | RESOLVED_APPLY_CLIENT | DISMISSED
  reason             String
  clientPayloadJson  String
  serverSnapshotJson String
  resolutionNotes    String?
  resolvedById       String?
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status, createdAt])
}

model NotificationEvent {
  id               String    @id @default(cuid())
  eventType        String    // JOURNAL_POSTED | APPROVAL_REQUIRED | LOW_STOCK | SYNC_COMPLETED | SYNC_CONFLICT | BACKUP_COMPLETED | RESTORE_COMPLETED | DEVICE_LOCKED | PASSWORD_RESET | SYSTEM_ALERT
  channel          String    @default("general") // approvals | sync | security | general
  severity         String    @default("INFO") // INFO | SUCCESS | WARNING | CRITICAL
  titleAr          String
  titleEn          String
  messageAr        String
  messageEn        String
  targetTab        String?
  targetEntityType String?
  targetEntityId   String?
  recipientUserId  String?
  actorUserId      String?
  isRead           Boolean   @default(false)
  readAt           DateTime?
  metadataJson     String    @default("{}")
  createdAt        DateTime  @default(now())

  @@index([isRead, createdAt])
  @@index([eventType, createdAt])
  @@index([recipientUserId, isRead])
}

model TenantDevice {
  id                String    @id @default(cuid())
  deviceId          String    @unique
  tenantSlug        String    @default("default")
  activationKey     String?
  platform          String    // web | windows | android | ios
  appVersion        String    @default("1.0.0")
  osVersion         String    @default("")
  deviceLabel       String    @default("")
  userId            String?
  userEmail         String?
  userDisplay       String?
  lastSeenAt        DateTime  @default(now())
  ipAddress         String?
  status            String    @default("ACTIVE") // ACTIVE | SUSPENDED | REVOKED
  syncMode          String    @default("AUTO") // AUTO | MANUAL
  syncIntervalSec   Int       @default(60)
  pendingQueueCount Int       @default(0)
  lastCursor        Int       @default(0)
  lastSyncAt        DateTime?
  lastSyncError     String?
  pendingCommand    String?   // SYNC_NOW | FORCE_FULL_RESYNC | WIPE_CREDENTIALS
  pendingCommandAt  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, lastSeenAt])
  @@index([userId])
}



