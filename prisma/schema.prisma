generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Note: For production Supabase / Cloud PostgreSQL deployment, run `npm run db:postgres`
// (or set provider = "postgresql") and apply Row-Level Security (RLS) policies.

// ---------------------------------------------------------
// 1. CHART OF ACCOUNTS & DOUBLE-ENTRY GENERAL LEDGER
// ---------------------------------------------------------

model Account {
  id           String             @id @default(cuid())
  code         String             @unique // e.g. "111101"
  nameAr       String
  nameEn       String
  level        Int                // 1 (Class / Gen 1) to 6 (Operational Posting Leaf / Gen 6)
  type         String             // ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  isPosting    Boolean            @default(false) // False for Gen 1-4 & branched Gen 5, True for leaf Gen 5 & Gen 6
  parentCode   String?            // Optional recursive parentCode for fast hierarchical lineage
  parentId     String?
  parent       Account?           @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Account[]          @relation("AccountHierarchy")

  journalLines JournalEntryLine[]
  vendors      Vendor[]
  customers    Customer[]
  workers      Worker[]
  treasury     TreasuryAccount?

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model JournalEntry {
  id          String             @id @default(cuid())
  entryNumber String             @unique // e.g. "JV-2026-0001"
  date        DateTime
  reference   String?            // External ref, PO#, Bill#, Invoice#, Voucher#
  narrationAr String
  narrationEn String?
  status      String             @default("POSTED") // DRAFT | PENDING_APPROVAL | APPROVED | POSTED | VOIDED
  sourceType  String?            // OPENING | VENDOR_BILL | VENDOR_PAYMENT | SALES_INVOICE | CUSTOMER_RECEIPT | EXPENSE | WORKER_ACCRUAL | WORKER_PAYOUT | ADJUSTMENT | MANUAL
  sourceId    String?
  projectId   String?
  project     Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  subProjectId String?
  subProject   SubProject?       @relation(fields: [subProjectId], references: [id], onDelete: SetNull)

  lines       JournalEntryLine[]
  attachments Attachment[]
  createdById String
  createdBy   User               @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model JournalEntryLine {
  id             String        @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)

  debit          Decimal       @default(0)
  credit         Decimal       @default(0)
  currency       String        @default("YER")
  exchangeRate   Decimal       @default(1.0)

  // Multi-Currency Normalized amounts (Base YER)
  debitBase      Decimal       @default(0)
  creditBase     Decimal       @default(0)

  memo           String?
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  subProjectId   String?
  subProject     SubProject?   @relation(fields: [subProjectId], references: [id], onDelete: SetNull)
  harvestCycleId String?
  harvestCycle   HarvestCycle? @relation(fields: [harvestCycleId], references: [id], onDelete: SetNull)
}

model Attachment {
  id             String        @id @default(cuid())
  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  fileName       String
  fileUrl        String
  fileType       String
  createdAt      DateTime      @default(now())
}

// ---------------------------------------------------------
// 2. ENTERPRISE PROFILE, SETTINGS & PROJECTS
// ---------------------------------------------------------

model EnterpriseProfile {
  id                     String   @id @default("default")
  legalNameAr            String
  legalNameEn            String
  taxNumber              String?
  commercialReg          String?
  currencyCode           String   @default("YER")
  isConfigured           Boolean  @default(false)
  address                String?
  phone                  String?
  email                  String?
  logoUrl                String?
  brandColor             String   @default("#059669")

  // Dual Logo Generator & Toggle Settings
  showUasLogo            Boolean  @default(true)
  uasLogoStyle           String   @default("emerald-shield")
  uasLogoCustomUrl       String?
  showEnterpriseLogo     Boolean  @default(true)
  enterpriseLogoStyle    String   @default("agri-leaf")
  enterpriseLogoCustomUrl String?

  // Landing Page CMS
  heroBadgeAr            String   @default("منصة محاسبة وتخطيط موارد المؤسسات الزراعية | UAS ERP 2026")
  heroBadgeEn            String   @default("Enterprise Agricultural Accounting & ERP | UAS 2026")
  heroTitleAr            String   @default("النظام المحاسبي الموحد لإدارة المشاريع الزراعية والقطفات والمخزون")
  heroTitleEn            String   @default("Unified Accounting System for Agricultural Projects, Harvests & Supply Chain")
  heroSubtitleAr         String   @default("دفتر يومية مزدوج القيد، شجرة حسابات خماسية، متابعة المشتريات والموردين، وإدارة الخزينة والبنوك والمحافظ الإلكترونية بدقة لحظية.")
  heroSubtitleEn         String   @default("Double-entry General Ledger, 5-tier COA, procurement & 3-way matching, and multi-currency vaults, banks & digital wallets.")
  aboutMissionAr         String   @default("تمكين المؤسسات الزراعية والتجارية من إدارة مشاريعها وقطفاتها ومستحقات الموردين والعملاء بشفافية مالية كاملة وتقارير فورية.")
  aboutMissionEn         String   @default("Empowering agricultural enterprises with full financial transparency, harvest-cycle control, and audit-ready reporting.")
  contactPhone           String   @default("")
  contactWhatsApp        String   @default("")
  contactAddress         String   @default("الجمهورية اليمنية - صنعاء")
  showPublicMetrics      Boolean  @default(true)
  showPublicVerify       Boolean  @default(true)
  ctaPrimaryTextAr       String   @default("دخول النظام المحاسبي")
  ctaPrimaryTextEn       String   @default("Enter ERP Workspace")

  updatedAt              DateTime @updatedAt
}

model SystemSettings {
  id              String   @id @default("default")
  orgName         String   @default("شركة الجبري الزراعية للتنمية والاستثمار | UAS")
  logoText        String   @default("UAS")
  defaultLang     String   @default("ar")
  defaultTheme    String   @default("emerald")
  defaultCurrency String   @default("YER")
  updatedAt       DateTime @updatedAt
}

model CurrencyRate {
  currencyCode String   @id // YER | SAR | USD
  rateToYER    Float
  updatedAt    DateTime @updatedAt
}

model Project {
  id                  String                    @id @default(cuid())
  code                String                    @unique
  name                String                    // Kept for compatibility with operational tabs
  nameAr              String
  nameEn              String
  type                String                    @default("مشروع رئيسي") // مشروع رئيسي | مشروع فرعي
  parentProjectId     String?
  parentProject       Project?                  @relation("ProjectHierarchy", fields: [parentProjectId], references: [id], onDelete: SetNull)
  childProjects       Project[]                 @relation("ProjectHierarchy")
  vendorId            String?
  ownerVendor         Vendor?                   @relation("ProjectOwnerVendor", fields: [vendorId], references: [id], onDelete: SetNull)
  budgetTotal         Decimal                   @default(0)
  estimatedValue      Float                     @default(0)
  plannedHarvestCount Int                       @default(1)
  status              String                    @default("ACTIVE")
  startDate           DateTime?
  endDate             DateTime?
  notes               String                    @default("")

  subProjects         SubProject[]
  harvestCycles       HarvestCycle[]
  acquisitions        ProjectAcquisitionCycle[]
  journalEntries      JournalEntry[]
  journalLines        JournalEntryLine[]
  purchaseOrders      PurchaseOrder[]
  vendorBills         VendorBill[]
  paymentVouchers     PaymentVoucher[]
  salesInvoices       SalesInvoice[]
  inventoryLots       InventoryLot[]
  expenses            OperatingExpense[]
  workerWages         WorkerWageEntry[]
  sales               SaleTransaction[]
  inventoryBatches    HarvestInventoryBatch[]
  adjustments         AdjustmentEntry[]

  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
}

model ProjectAcquisitionCycle {
  id              String           @id @default(cuid())
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cycleTitle      String
  startDate       DateTime
  endDate         DateTime
  contractAmount  Decimal          @default(0)
  currency        String           @default("YER")
  status          String           @default("ACTIVE") // DRAFT | ACTIVE | PARTIALLY_PAID | PAID | COMPLETED | VOIDED
  notes           String?

  purchaseOrders  PurchaseOrder[]
  vendorBills     VendorBill[]
  paymentVouchers PaymentVoucher[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model SubProject {
  id               String                  @id @default(cuid())
  projectId        String
  project          Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code             String
  nameAr           String
  nameEn           String
  budget           Decimal                 @default(0)
  status           String                  @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED
  notes            String                  @default("")
  vendorId         String?
  vendor           Vendor?                 @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  journalEntries   JournalEntry[]
  journalLines     JournalEntryLine[]
  purchaseOrders   PurchaseOrder[]
  vendorBills      VendorBill[]
  paymentVouchers  PaymentVoucher[]
  salesInvoices    SalesInvoice[]
  receiptVouchers  ReceiptVoucher[]
  sales            SaleTransaction[]
  expenses         OperatingExpense[]
  workerWages      WorkerWageEntry[]
  inventoryBatches HarvestInventoryBatch[]

  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @default(now()) @updatedAt

  @@unique([projectId, code])
}

model HarvestCycle {
  id               String                  @id @default(cuid())
  projectId        String
  project          Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cycleNumber      Int                     @default(1)
  name             String
  sortOrder        Int                     @default(0)
  isLocked         Boolean                 @default(false)
  lockedByUserId   String?
  lockedById       String?
  lockedAt         DateTime?
  createdAt        DateTime                @default(now())

  inventoryLots    InventoryLot[]
  journalLines     JournalEntryLine[]
  salesInvoices    SalesInvoice[]
  expenses         OperatingExpense[]
  workerWages      WorkerWageEntry[]
  sales            SaleTransaction[]
  inventoryBatches HarvestInventoryBatch[]
  adjustments      AdjustmentEntry[]

  @@unique([projectId, name])
}

// ---------------------------------------------------------
// 3. PROCUREMENT & VENDORS
// ---------------------------------------------------------

model Vendor {
  id              String           @id @default(cuid())
  code            String           @unique
  nameAr          String
  nameEn          String?
  phone           String
  email           String?
  taxRegistration String?
  address         String?

  accountId       String           @unique // Linked Tier 5 Payables Account (2111xx)
  account         Account          @relation(fields: [accountId], references: [id], onDelete: Restrict)

  ownedProjects   Project[]        @relation("ProjectOwnerVendor")
  subProjects     SubProject[]
  purchaseOrders  PurchaseOrder[]
  bills           VendorBill[]
  payments        PaymentVoucher[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model PurchaseOrder {
  id                 String                   @id @default(cuid())
  poNumber           String                   @unique // e.g. "PO-2026-0042"
  vendorId           String
  vendor             Vendor                   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  projectId          String
  project            Project                  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  subProjectId       String?
  subProject         SubProject?              @relation(fields: [subProjectId], references: [id], onDelete: SetNull)
  acquisitionCycleId String?
  acquisitionCycle   ProjectAcquisitionCycle? @relation(fields: [acquisitionCycleId], references: [id], onDelete: SetNull)

  date               DateTime                 @default(now())
  status        String              @default("DRAFT") // DRAFT | PENDING_APPROVAL | APPROVED | POSTED | PAID | VOIDED
  subTotal      Decimal             @default(0)
  taxTotal      Decimal             @default(0)
  grandTotal    Decimal             @default(0)
  currency      String              @default("YER")
  notes         String?

  items         PurchaseOrderItem[]
  bills         VendorBill[]
  goodsReceipts GoodsReceipt[]

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  description     String
  unit            String
  quantity        Decimal
  unitPrice       Decimal
  totalPrice      Decimal
}

model GoodsReceipt {
  id              String        @id @default(cuid())
  grnNumber       String        @unique // e.g. "GRN-2026-0012"
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receivedDate    DateTime      @default(now())
  receivedTotal   Decimal       @default(0)
  hasVariance     Boolean       @default(false)
  itemsSummary    String?       // JSON summary of received quantities vs ordered
  warehouseNotes  String?
  createdAt       DateTime      @default(now())
}

model VendorBill {
  id                 String                   @id @default(cuid())
  billNumber         String                   @unique // e.g. "BILL-2026-0089"
  vendorId           String
  vendor             Vendor                   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  projectId          String
  project            Project                  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  subProjectId       String?
  subProject         SubProject?              @relation(fields: [subProjectId], references: [id], onDelete: SetNull)
  purchaseOrderId    String?
  purchaseOrder      PurchaseOrder?           @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  acquisitionCycleId String?
  acquisitionCycle   ProjectAcquisitionCycle? @relation(fields: [acquisitionCycleId], references: [id], onDelete: SetNull)

  date               DateTime
  dueDate         DateTime?
  status          String           @default("APPROVED") // DRAFT | APPROVED | POSTED | PARTIALLY_PAID | PAID | VOIDED
  totalAmount     Decimal
  paidAmount      Decimal          @default(0)
  balanceDue      Decimal
  currency        String           @default("YER")
  isInventory     Boolean          @default(false)
  debitAccountId  String?
  journalEntryId  String?
  notes           String?

  paymentVouchers PaymentVoucher[]
  createdAt       DateTime         @default(now())
}

model PaymentVoucher {
  id                 String                   @id @default(cuid())
  voucherNumber      String                   @unique // e.g. "PV-2026-0034"
  date               DateTime                 @default(now())
  vendorId           String
  vendor             Vendor                   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  billId             String?
  bill               VendorBill?              @relation(fields: [billId], references: [id], onDelete: SetNull)
  treasuryId         String
  treasury           TreasuryAccount          @relation(fields: [treasuryId], references: [id], onDelete: Restrict)

  amount             Decimal
  transferFee        Decimal                  @default(0)
  currency           String                   @default("YER")
  referenceNumber    String?
  notes              String?
  projectId          String?
  project            Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  subProjectId       String?
  subProject         SubProject?              @relation(fields: [subProjectId], references: [id], onDelete: SetNull)
  acquisitionCycleId String?
  acquisitionCycle   ProjectAcquisitionCycle? @relation(fields: [acquisitionCycleId], references: [id], onDelete: SetNull)
  journalEntryId     String?
  qrVerificationHash String?

  createdAt          DateTime                 @default(now())
}

// ---------------------------------------------------------
// 4. CLIENTS, SALES & RECEIVABLES
// ---------------------------------------------------------

model Customer {
  id          String            @id @default(cuid())
  code        String            @unique
  name        String            @unique
  nameAr      String
  nameEn      String?
  phone       String            @default("")
  address     String?
  creditLimit Decimal           @default(0)

  accountId   String            @unique // Linked Tier 5 Receivables Account (1121xx)
  account     Account           @relation(fields: [accountId], references: [id], onDelete: Restrict)

  invoices    SalesInvoice[]
  receipts    ReceiptVoucher[]
  sales       SaleTransaction[]
  createdAt   DateTime          @default(now())
}

model SalesInvoice {
  id                 String           @id @default(cuid())
  invoiceNumber      String           @unique
  customerId         String
  customer           Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  projectId          String
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  subProjectId       String?
  subProject         SubProject?      @relation(fields: [subProjectId], references: [id], onDelete: SetNull)
  harvestCycleId     String?
  harvestCycle       HarvestCycle?    @relation(fields: [harvestCycleId], references: [id], onDelete: SetNull)

  sequenceNumber     String?          // e.g. "SO-2026-0001"
  dailyBatchLabel    String?
  salesOfficerId     String?
  salesOfficerTitle  String?
  revenueAccountCode String?          @default("411101")
  treasuryAccountId  String?
  treasuryAccount    TreasuryAccount? @relation(fields: [treasuryAccountId], references: [id], onDelete: SetNull)

  date               DateTime         @default(now())
  totalAmount        Decimal
  paidAmount         Decimal          @default(0)
  balanceDue         Decimal
  status             String           @default("POSTED") // DRAFT | POSTED | PARTIALLY_PAID | PAID | VOIDED
  currency           String           @default("YER")
  notes              String?
  journalEntryId     String?
  qrVerificationHash String?

  receipts           ReceiptVoucher[]
  createdAt          DateTime         @default(now())
}

model ReceiptVoucher {
  id                 String          @id @default(cuid())
  voucherNumber      String          @unique
  date               DateTime        @default(now())
  customerId         String
  customer           Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoiceId          String?
  invoice            SalesInvoice?   @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  treasuryId         String
  treasury           TreasuryAccount @relation(fields: [treasuryId], references: [id], onDelete: Restrict)
  subProjectId       String?
  subProject         SubProject?     @relation(fields: [subProjectId], references: [id], onDelete: SetNull)

  amount             Decimal
  currency           String          @default("YER")
  notes              String?
  journalEntryId     String?
  qrVerificationHash String?
  createdAt          DateTime        @default(now())
}

// ---------------------------------------------------------
// 5. INVENTORY & AGRICULTURAL LOT TRACKING
// ---------------------------------------------------------

model InventoryLot {
  id              String        @id @default(cuid())
  lotNumber       String        @unique
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  harvestCycleId  String?
  harvestCycle    HarvestCycle? @relation(fields: [harvestCycleId], references: [id], onDelete: SetNull)
  grade           String        // "صنف 1", "صنف 2", "روس", "بزغة"
  initialQuantity Decimal
  currentQuantity Decimal
  shrinkageCount  Decimal       @default(0)
  unitCost        Decimal       @default(0)
  createdAt       DateTime      @default(now())
}

model HarvestInventoryBatch {
  id               String        @id @default(cuid())
  projectId        String
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subProjectId     String?
  subProject       SubProject?   @relation(fields: [subProjectId], references: [id], onDelete: SetNull)
  harvestCycleId   String?
  harvestCycle     HarvestCycle? @relation(fields: [harvestCycleId], references: [id], onDelete: SetNull)
  harvestName      String
  productGrade     String
  harvestedBundles Int
  shrinkageBundles Int           @default(0)
  notes            String        @default("")
  createdAt        DateTime      @default(now())
}

// ---------------------------------------------------------
// 6. TREASURY, FIELD OPERATIONS & USERS
// ---------------------------------------------------------

model TreasuryAccount {
  id                 String               @id @default(cuid())
  code               String               @unique
  name               String
  nameAr             String
  nameEn             String
  type               String               @default("VAULT") // VAULT | BANK | WALLET
  providerNameAr     String               @default("")
  providerNameEn     String               @default("")
  accountHolderName  String               @default("")
  accountNumber      String
  ibanOrSwift        String               @default("")
  branchOrAgent      String               @default("")
  transferFeePercent Float                @default(0)
  dailyLimit         Decimal              @default(0)
  isDefaultReceipts  Boolean              @default(false)
  isDefaultPayments  Boolean              @default(false)
  isActive           Boolean              @default(true)
  notes              String               @default("")
  accountId          String               @unique
  account            Account              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  balance            Decimal              @default(0)
  balanceYER         Float                @default(0)
  currency           String               @default("YER")
  currencyCode       String               @default("YER")
  updatedAt          DateTime             @updatedAt

  paymentVouchers    PaymentVoucher[]
  receiptVouchers    ReceiptVoucher[]
  installments       InstallmentVoucher[]
  salesInvoices      SalesInvoice[]
  salesTransactions  SaleTransaction[]
}

model OperatingExpense {
  id             String        @id @default(cuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subProjectId   String?
  subProject     SubProject?   @relation(fields: [subProjectId], references: [id], onDelete: SetNull)
  harvestCycleId String?
  harvestCycle   HarvestCycle? @relation(fields: [harvestCycleId], references: [id], onDelete: SetNull)
  harvestName    String
  category       String        // وقود/محروقات | وجبات غذائية | مواد غذائية | أجور نقل | أخرى
  subType        String
  quantity       Float         @default(1)
  unitPrice      Float         @default(0)
  totalAmount    Float         @default(0)
  expenseDate    String
  notes          String        @default("")
  journalEntryId String?
  createdAt      DateTime      @default(now())
}

model Worker {
  id               String            @id @default(cuid())
  name             String            @unique
  phone            String            @default("")
  defaultDailyWage Float             @default(0)
  accountId        String?
  account          Account?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  wageEntries      WorkerWageEntry[]
}

model WorkerWageEntry {
  id             String               @id @default(cuid())
  workerId       String
  worker         Worker               @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerName     String
  projectId      String
  project        Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subProjectId   String?
  subProject     SubProject?          @relation(fields: [subProjectId], references: [id], onDelete: SetNull)
  harvestCycleId String?
  harvestCycle   HarvestCycle?        @relation(fields: [harvestCycleId], references: [id], onDelete: SetNull)
  harvestName    String
  dailyWage      Float
  daysWorked     Float
  totalWage      Float
  creditAmount   Float                @default(0)
  debitBalance   Float
  workDate       String
  notes          String               @default("")
  journalEntryId String?
  createdAt      DateTime             @default(now())
  installments   InstallmentVoucher[]
}

model SaleTransaction {
  id                 String               @id @default(cuid())
  sequenceNumber     String?              // e.g. "SO-2026-0001"
  dailyBatchLabel    String?              // e.g. "عملية بيع #5" / "دفعة صباحية"
  salesOfficerId     String?
  salesOfficerTitle  String?
  revenueAccountCode String               @default("411101")
  treasuryAccountId  String?
  treasuryAccount    TreasuryAccount?     @relation(fields: [treasuryAccountId], references: [id], onDelete: SetNull)

  projectId          String
  project            Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subProjectId       String?
  subProject         SubProject?          @relation(fields: [subProjectId], references: [id], onDelete: SetNull)
  harvestCycleId     String?
  harvestCycle       HarvestCycle?        @relation(fields: [harvestCycleId], references: [id], onDelete: SetNull)
  harvestName        String
  saleBatchLabel     String
  customerId         String
  customer           Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerName       String
  customerPhone      String
  productGrade       String
  bundlesCount       Int
  unitPrice          Float
  totalAmount        Float
  creditPaid         Float                @default(0)
  debitReceivable    Float
  saleDate           String
  receiptVoucherNo   String
  notes              String               @default("")
  journalEntryId     String?
  createdAt          DateTime             @default(now())
  installments       InstallmentVoucher[]
}

model InstallmentVoucher {
  id                 String           @id @default(cuid())
  voucherNo          String           @unique
  type               String           // CUSTOMER_RECEIPT | WORKER_PAYOUT
  saleTransactionId  String?
  saleTransaction    SaleTransaction? @relation(fields: [saleTransactionId], references: [id], onDelete: SetNull)
  workerWageEntryId  String?
  workerWageEntry    WorkerWageEntry? @relation(fields: [workerWageEntryId], references: [id], onDelete: SetNull)
  targetName         String
  phone              String           @default("")
  treasuryAccountId  String
  treasuryAccount    TreasuryAccount  @relation(fields: [treasuryAccountId], references: [id], onDelete: Restrict)
  amountYER          Float
  qrVerificationHash String
  paymentDate        String
  notes              String           @default("")
  journalEntryId     String?
  createdAt          DateTime         @default(now())
}

enum Role {
  SUPER_ADMIN
  PROJECT_MANAGER
  CHIEF_ACCOUNTANT
  PROCUREMENT_OFFICER
  SALES_COLLECTOR
  FIELD_ACCOUNTANT
  EXTERNAL_AUDITOR
}

model User {
  id                    String         @id @default(cuid())
  username              String         @unique
  name                  String
  fullName              String
  displayName           String?        // Optional personal display name (defaults to empty so system displays title-only role)
  phone                 String?        // Optional personal mobile phone
  email                 String         @unique
  passwordHash          String
  role                  Role           @default(FIELD_ACCOUNTANT)
  department            String         @default("المالية والعمليات")
  active                Boolean        @default(true)
  isActive              Boolean        @default(true)
  avatarChar            String         @default("م")
  avatarUrl             String?        // Profile photo URL
  avatarColor           String         @default("#059669")
  preferredLang         String         @default("ar")
  preferredCurrency     String         @default("YER")
  preferredTheme        String         @default("emerald")
  defaultModule         String?        // Default home module tab id
  lastLoginAt           DateTime?
  useCustomPermissions  Boolean        @default(false)
  customAllowedGroups   String         @default("[]") // JSON array of allowed ErpGroupId strings
  customPermissionsJson String         @default("{}") // JSON object of granular overrides
  mustChangePassword    Boolean        @default(false)
  passwordUpdatedAt     DateTime?
  assignedProjects      String         @default("[]") // JSON array of project IDs for row-level access
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  journalEntries        JournalEntry[]
  auditLogs             AuditLog[]
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  action    String   // CREATE, UPDATE, POST, VOID, LOCK
  entity    String   // "JournalEntry", "VendorBill", "HarvestCycle"
  entityId  String
  details   Json
  ipAddress String?
  timestamp DateTime @default(now())
}

model ImmutableAuditLog {
  id              String   @id @default(cuid())
  timestamp       String
  userId          String?
  userDisplay     String
  userRole        String
  actionType      String
  entityReference String
  details         String
  sha256Hash      String
  createdAt       DateTime @default(now())
}

model AdjustmentEntry {
  id             String        @id @default(cuid())
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  harvestCycleId String?
  harvestCycle   HarvestCycle? @relation(fields: [harvestCycleId], references: [id], onDelete: SetNull)
  periodLabel    String
  reason         String
  amountYER      Float
  createdByUser  String
  journalEntryId String?
  createdAt      DateTime      @default(now())
}
